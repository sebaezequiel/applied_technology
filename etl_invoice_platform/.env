# =============================================================
# ETL Inteligente de Facturas — Variables de entorno
# Copiá este archivo como .env y completá los valores reales
# NUNCA subas el archivo .env al repositorio
# =============================================================

# ── MinIO (Object Storage local via Docker) ──────────────────
# Usuario y contraseña para acceder a MinIO
# Usá cualquier valor, son credenciales locales
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123

# Endpoint donde escucha MinIO (no cambiar si usás docker-compose)
MINIO_ENDPOINT=localhost:9000

# Nombre del bucket donde se guardarán las facturas
MINIO_BUCKET=invoices

# Dejar en false para desarrollo local (sin HTTPS)
MINIO_USE_SSL=false

# ── Google Gemini API ─────────────────────────────────────────
# Obtené tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Supabase (Base de datos PostgreSQL hosted) ────────────────
# Encontrás estos valores en: Supabase → Settings → API
SUPABASE_URL=https://lzeawmpqzmmdxoffayok.supabase.co
SUPABASE_KEY=Sasori122023!