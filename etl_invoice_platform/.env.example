# =============================================================
# ETL Inteligente de Facturas — Variables de entorno
# Copiá este archivo como .env y completá los valores reales
# NUNCA subas el archivo .env al repositorio
# =============================================================

# ── Google Gemini API ─────────────────────────────────────────
# Obtené tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Supabase (Base de datos + Object Storage) ─────────────────
# Encontrás estos valores en: Supabase → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key_here

# Nombre del bucket de Supabase Storage donde se guardan las facturas
# Se crea desde el dashboard: Storage → New bucket (privado)
SUPABASE_BUCKET=invoices
